{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateSandboxNetworkInStockholm",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateRouteTable",
        "ec2:AssociateRouteTable",
        "ec2:CreateTags",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:vpc/*",
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:subnet/*",
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:route-table/*",
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    }
  ]
}
