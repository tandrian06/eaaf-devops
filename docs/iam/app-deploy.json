{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcsSandbox",
      "Effect": "Allow",
      "Action": [
        "ecs:CreateCluster",
        "ecs:DescribeClusters",
        "ecs:PutClusterCapacityProviders",
        "ecs:CreateService",
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTagsForResource",
        "ecs:TagResource"
      ],
      "Resource": [
        "arn:aws:ecs:eu-north-1:<AWS_ACCOUNT_ID>:cluster/eaaf-devops-sandbox",
        "arn:aws:ecs:eu-north-1:<AWS_ACCOUNT_ID>:service/eaaf-devops-sandbox/eaaf-devops-sandbox",
        "arn:aws:ecs:eu-north-1:<AWS_ACCOUNT_ID>:task-definition/eaaf-devops-sandbox:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "EcsRegionalOperations",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTasks",
        "ecs:DescribeTasks",
        "ecs:ListAccountSettings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "LoadBalancerWrites",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:AddTags",
        "elasticloadbalancing:ModifyLoadBalancerAttributes",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:ModifyListenerAttributes"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-north-1:<AWS_ACCOUNT_ID>:loadbalancer/app/eaaf-devops-sandbox/*",
        "arn:aws:elasticloadbalancing:eu-north-1:<AWS_ACCOUNT_ID>:listener/app/eaaf-devops-sandbox/*/*",
        "arn:aws:elasticloadbalancing:eu-north-1:<AWS_ACCOUNT_ID>:targetgroup/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "AppNetworkRules",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:CreateTags",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ValidateSecurityGroupQuotasForInterface"
      ],
      "Resource": [
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:vpc/<VPC_ID>",
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:eu-north-1:<AWS_ACCOUNT_ID>:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "SandboxLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:TagResource",
        "logs:TagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:eu-north-1:<AWS_ACCOUNT_ID>:log-group:/aws/ecs/eaaf-devops-sandbox",
        "arn:aws:logs:eu-north-1:<AWS_ACCOUNT_ID>:log-group:/aws/ecs/eaaf-devops-sandbox:*",
        "arn:aws:logs:eu-north-1:<AWS_ACCOUNT_ID>:log-group:/aws/ecs/eaaf-devops-sandbox/app",
        "arn:aws:logs:eu-north-1:<AWS_ACCOUNT_ID>:log-group:/aws/ecs/eaaf-devops-sandbox/app:*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "DescribeLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        }
      }
    },
    {
      "Sid": "EcsScaling",
      "Effect": "Allow",
      "Action": [
        "application-autoscaling:RegisterScalableTarget",
        "application-autoscaling:DescribeScalableTargets",
        "application-autoscaling:PutScalingPolicy",
        "application-autoscaling:DescribeScalingPolicies",
        "application-autoscaling:ListTagsForResource",
        "application-autoscaling:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-north-1"
        },
        "StringEqualsIfExists": {
          "application-autoscaling:service-namespace": "ecs"
        }
      }
    },
    {
      "Sid": "CreateAndReadTaskExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/eaaf-devops-sandbox-*"
    },
    {
      "Sid": "CreateAndReadTaskExecutionPolicy",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:ListPolicyTags",
        "iam:TagPolicy"
      ],
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/eaaf-devops-sandbox-*"
    },
    {
      "Sid": "AttachOnlySandboxPolicy",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/eaaf-devops-sandbox-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/eaaf-devops-sandbox-*"
        }
      }
    },
    {
      "Sid": "PassOnlySandboxTaskExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/eaaf-devops-sandbox-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": [
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/ecs.amazonaws.com/*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/*",
        "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/elasticloadbalancing.amazonaws.com/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "ecs.application-autoscaling.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    }
  ]
}
